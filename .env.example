# Vercel dashboard -> AI Gateway -> API Keys -> Create key (starts with vck_)
AI_GATEWAY_API_KEY=

# Provider selection: gateway | typesafe | openrouter. Unset = first key found (typesafe, gateway, openrouter).
JEV_PROVIDER=
# Direct TypeSafe (https://typesafe.ai) — no Vercel rate limit
TYPESAFE_AI_API_KEY=
# OpenRouter (beta). Run `pnpm probe:openrouter` to find the base URL, then set it here.
OPENROUTER_API_KEY=
OPENROUTER_JEV_BASE_URL=https://openrouter.ai/api/alpha
